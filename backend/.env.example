DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mssql
DB_NAME=homebase_expenses_mssql
# Blank user/password uses the Windows identity running Django.
DB_USER=
DB_PASSWORD=
# Shared memory for the local default instance; no public SQL port needed.
DB_HOST=lpc:localhost
DB_PORT=
# Local development only. Use a trusted server certificate in production.
DB_TRUST_SERVER_CERTIFICATE=True
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=homebase-expenses@localhost
FRONTEND_URL=http://127.0.0.1:5174
# Test notifications are labelled clearly. Local/private app links are omitted.
EMAIL_TEST_MODE=False
# For real delivery, change EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and supply your approved mail provider's credentials in backend/.env, not in chat.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
# One application sender serves all users. No per-user Gmail/Zoho connection.
# Gmail testing: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True,
# EMAIL_HOST_USER=your-sender@gmail.com, EMAIL_HOST_PASSWORD=a Google App Password.
# For a transactional provider, use its SMTP host, username, key/password and
# authorized sender instead. Never use a normal user's email password.
# Optional: absolute path to a private upload directory dedicated to this app.
# PRIVATE_EVIDENCE_ROOT=C:/Users/HP/Desktop/HomebaseExpenses/backend/private_evidence
